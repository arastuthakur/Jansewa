# JanSewa AI Nepal - Environment Variables Example
# Duplicate this file to .env and configure your keys

# Google Gemini API Key (obtained from https://aistudio.google.com/app/apikey)
GEMINI_API=your_google_gemini_api_key_here
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: Port configuration
PORT=3000
